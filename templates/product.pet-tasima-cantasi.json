    "mp_columns_3": {
      "type": "mispati-columns",
      "blocks": {
        "b1": {
          "type": "column",
          "settings": {
            "icon": "check",
            "title": "Freewalk Ne İşe Yarar",
            "text": "<p><strong>Freewalk</strong>, ellerinizi serbest bırakır ve dostunuzun sizi <strong>çekiştirmesine engel </strong>olur. Tasma ve eşya taşıma derdini ortadan kaldırır. <strong>Hareketli </strong>dostunuzda sizi artık sağa sola <strong>çekiştiremez</strong></p>"
          }
        },
        "b2": {
          "type": "column",
          "settings": {
            "icon": "check",
            "title": "Yürüyüş Sistemi Nasıl İşler",
            "text": "<p>Freewalk'ı <strong>bel ölçünüze göre ayarlayın</strong>, eşyalarınızı <strong>klipslere </strong>ve bel çantasına yerleştirin. Kordonuda dostunuzla aranızdaki <strong>mesafeye </strong>göre ayarladıktan sonra eller serbest yürüyüşe <strong>hazırsınız</strong>.</p>"
          }
        },
        "b3": {
          "type": "column",
          "settings": {
            "icon": "check",
            "title": "Tarzınıza Uyum Sağlar",
            "text": "<p>Sade, siyah ve <strong>modern tasarımıyla</strong> spor kombinlerinden günlük kıyafetlere kadar stilinizi bozmadan <strong>her yürüyüşe eşlik eder.</strong></p>"
          }
        }
      },
