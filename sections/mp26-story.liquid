<section class="mp26-story" aria-labelledby="mp26-story-{{ section.id }}">
  <div class="mp26-wrap">
    <div class="mp26-story__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="mp26-h2" id="mp26-story-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="mp26-story__aside">
        {%- if section.settings.text != blank -%}
          <p class="mp26-lead">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="mp26-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
            {% render 'mispati-icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    <ol class="mp26-story__list" role="list">
      {%- for block in section.blocks -%}
        <li class="mp26-moment" {{ block.shopify_attributes }}>
          {%- if block.settings.time != blank -%}
            <p class="mp26-moment__time"><strong>{{ block.settings.time }}</strong></p>
          {%- endif -%}
          <div class="mp26-moment__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="mp26-moment__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="mp26-moment__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Yürüyüş Hikâyesi 2026",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Bir sonbahar akşamı, üç an." },
    { "type": "text", "id": "text", "label": "Açıklama" },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Ceketi incele" },
    { "type": "url", "id": "button_link", "label": "Buton bağlantısı" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "An",
      "settings": [
        { "type": "text", "id": "time", "label": "Saat", "default": "18:40" },
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Kapıdan çıkarken" },
        { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Bu anı anlatan kısa bir cümle.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Yürüyüş Hikâyesi 2026", "blocks": [{ "type": "moment" }, { "type": "moment" }, { "type": "moment" }] }]
}
{% endschema %}