<section class="pb pb--cream" style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pb__wrap">
    <div class="pb__head">
      {%- if section.settings.eyebrow != blank -%}<span class="pb__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="pb__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="pb__lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="pb-steps">
      {%- for block in section.blocks -%}
        <div class="pb-step" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="pb-step__media">{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.title }}</div>
          {%- elsif request.design_mode -%}
            <div class="pb-step__media pb__ph">Görsel ekleyin</div>
          {%- endif -%}
          <div class="pb-step__body">
            <span class="pb-step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Adımlar",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Nasıl çalışır?" },
    { "type": "richtext", "id": "text", "label": "Açıklama" },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    { "type": "step", "name": "Adım", "settings": [
      { "type": "image_picker", "id": "image", "label": "Görsel" },
      { "type": "text", "id": "title", "label": "Başlık", "default": "Adım" },
      { "type": "textarea", "id": "text", "label": "Metin" }
    ] }
  ],
  "presets": [{ "name": "Premium Adımlar", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
