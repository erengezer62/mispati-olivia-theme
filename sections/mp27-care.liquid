<section
  class="mp27 mp27-care mp27--{{ section.settings.bg }} mp27-pad"
  style="--mp27-pt: {{ section.settings.pt }}px; --mp27-pb: {{ section.settings.pb }}px;"
>
  <div class="mp26-wrap">
    <div class="mp27-care__head">
      <div class="mp27-head">
        {%- if section.settings.kicker != blank -%}<p class="mp27-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="mp26-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="mp26-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="mp27-care__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="mp27-care__track" role="list">
      {%- for p in section.settings.products -%}
        <a class="mp27-care__card" href="{{ p.url }}" role="listitem">
          <div class="mp27-care__img">
            {%- if p.featured_media -%}
              {{ p.featured_media | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 25vw, 62vw', loading: 'lazy', alt: p.featured_media.alt | default: p.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <p class="mp27-care__title">{{ p.title }}</p>
          <p class="mp27-care__price">{{ p.price_min | money }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mispati 2027 Ürün şeridi",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Arka plan", "default": "white", "options": [
      { "value": "paper", "label": "Kağıt" },
      { "value": "sand", "label": "Kum" },
      { "value": "white", "label": "Beyaz" }
    ] },
    { "type": "text", "id": "kicker", "label": "Üst etiket" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Yürüyüşün öncesi ve sonrası için" },
    { "type": "textarea", "id": "text", "label": "Açıklama" },
    { "type": "product_list", "id": "products", "label": "Ürünler", "limit": 12 },
    { "type": "text", "id": "link_label", "label": "Bağlantı yazısı", "default": "Tüm ürünler" },
    { "type": "url", "id": "link", "label": "Bağlantı" },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Mispati 2027 Ürün şeridi" }]
}
{% endschema %}
