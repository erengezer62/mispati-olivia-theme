{%- comment -%}
  Mispati Yorum Duvarı — gerçek müşteri yorumları bloklar olarak eklenir.
  Ortalama puan ve dağılım eklenen yorumlardan otomatik hesaplanır.
  "Yorum Yaz" formu Shopify iletişim formu üzerinden mağaza e-postasına iletilir (uygulama gerekmez).
{%- endcomment -%}
{%- liquid
  assign total = 0
  assign sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  for block in section.blocks
    assign total = total | plus: 1
    assign sum = sum | plus: block.settings.rating
    case block.settings.rating
      when 5
        assign c5 = c5 | plus: 1
      when 4
        assign c4 = c4 | plus: 1
      when 3
        assign c3 = c3 | plus: 1
      when 2
        assign c2 = c2 | plus: 1
      else
        assign c1 = c1 | plus: 1
    endcase
  endfor
  if total > 0
    assign avg = sum | times: 1.0 | divided_by: total | round: 1
  endif
  assign form_id = 'pb-review-' | append: section.id
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8L12 2.5z"/></svg>{%- endcapture -%}
<section class="pb pb--paper" id="yorumlar" style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pb__wrap" data-pb-rev>
    <div class="pb__head" style="margin-bottom:36px">
      {%- if section.settings.eyebrow != blank -%}<span class="pb__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="pb__title">{{ section.settings.heading }}</h2>
    </div>

    {%- if total > 0 -%}
      <div class="pb-rev__top">
        <div class="pb-rev__score">
          <div class="pb-rev__avg">{{ avg }}</div>
          <div>
            <div class="pb-rev__stars">{% for i in (1..5) %}{{ star }}{% endfor %}</div>
            <div class="pb-rev__count">{{ total }} değerlendirme</div>
          </div>
        </div>
        <div>
          <div class="pb-rev__bars">
            {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
            {%- for c in counts -%}
              {%- assign stars_label = 6 | minus: forloop.index -%}
              {%- assign pct = c | times: 100 | divided_by: total -%}
              <div class="pb-rev__bar"><span>{{ stars_label }} ★</span><span><i style="width: {{ pct }}%"></i></span><span>{{ c }}</span></div>
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="pb-rev__actions" style="margin-bottom:28px">
        <button type="button" class="pb-btn" data-open-form>Yorum Yaz</button>
      </div>

      <div class="pb-rev__grid">
        {%- for block in section.blocks -%}
          {%- assign initial = block.settings.name | slice: 0 -%}
          <article class="pb-rev__card"{% if forloop.index > section.settings.initial %} hidden data-extra{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="pb-rev__img">{{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.name }}</div>
            {%- endif -%}
            <div class="pb-rev__body">
              <div class="pb-rev__meta">
                <span class="pb-rev__stars">{% for i in (1..block.settings.rating) %}{{ star }}{% endfor %}</span>
                {%- if block.settings.date != blank -%}<span class="pb-rev__date">{{ block.settings.date }}</span>{%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}<h3 class="pb-rev__title">{{ block.settings.title }}</h3>{%- endif -%}
              <div class="pb-rev__text">{{ block.settings.text }}</div>
              <div class="pb-rev__who">
                <span class="pb-rev__avatar">{{ initial | upcase }}</span>
                <div><strong>{{ block.settings.name }}</strong>{% if block.settings.city != blank %} <span>· {{ block.settings.city }}</span>{% endif %}</div>
                {%- if block.settings.verified -%}
                  <span class="pb-rev__ver">{% render 'mispati-icon', name: 'verified' %}Doğrulanmış alıcı</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if total > section.settings.initial -%}
        <div class="pb-rev__more"><button type="button" class="pb-btn pb-btn--ghost" data-more>Tüm yorumları göster ({{ total }})</button></div>
      {%- endif -%}
    {%- else -%}
      <div class="pb-rev__empty">
        <h3>{{ section.settings.empty_title }}</h3>
        <p>{{ section.settings.empty_text }}</p>
        <button type="button" class="pb-btn" data-open-form>Yorum Yaz</button>
      </div>
    {%- endif -%}

    {%- form 'contact', id: form_id, class: 'pb-rev__form' -%}
      {%- if form.posted_successfully? or form.errors -%}<script>document.currentScript.closest('form').classList.add('is-open');</script>{%- endif -%}
      <h3>Deneyiminizi paylaşın</h3>
      <p>Yorumunuz ekibimize iletilir, onaylandıktan sonra bu sayfada yayınlanır. Fotoğraf eklemek isterseniz yorum sonrası size e-postayla döneceğiz.</p>
      {%- if form.posted_successfully? -%}
        <div class="pb-rev__ok">Teşekkürler! Yorumunuz bize ulaştı; kısa süre içinde inceleyip yayınlayacağız.</div>
      {%- else -%}
        <input type="hidden" name="contact[Konu]" value="Ürün yorumu">
        <input type="hidden" name="contact[Ürün]" value="{{ product.title | escape }}">
        <div class="pb-rev__fields">
          <div class="is-wide">
            <label>Puanınız</label>
            <div class="pb-rate">
              {%- for i in (1..5) -%}
                {%- assign v = 6 | minus: i -%}
                <input type="radio" id="{{ form_id }}-r{{ v }}" name="contact[Puan]" value="{{ v }} yıldız" {% if v == 5 %}checked{% endif %}>
                <label for="{{ form_id }}-r{{ v }}" aria-label="{{ v }} yıldız">{{ star }}</label>
              {%- endfor -%}
            </div>
          </div>
          <div>
            <label for="{{ form_id }}-name">Adınız</label>
            <input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div>
            <label for="{{ form_id }}-email">E-posta (yayınlanmaz)</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <div>
            <label for="{{ form_id }}-city">Şehir (isteğe bağlı)</label>
            <input id="{{ form_id }}-city" type="text" name="contact[Şehir]">
          </div>
          <div>
            <label for="{{ form_id }}-dog">Köpeğinizin ırkı ve bedeni (isteğe bağlı)</label>
            <input id="{{ form_id }}-dog" type="text" name="contact[Irk ve beden]" placeholder="Örn. Golden, XL">
          </div>
          <div class="is-wide">
            <label for="{{ form_id }}-body">Yorumunuz</label>
            <textarea id="{{ form_id }}-body" name="contact[body]" required placeholder="Botu nerede, nasıl kullandınız? Köpeğiniz alışabildi mi?"></textarea>
          </div>
        </div>
        {%- if form.errors -%}<div class="pb-rev__err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div style="margin-top:18px"><button type="submit" class="pb-btn">Yorumu Gönder</button></div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('#shopify-section-{{ section.id }} [data-pb-rev]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var form = root.querySelector('.pb-rev__form');
  root.querySelectorAll('[data-open-form]').forEach(function (b) {
    b.addEventListener('click', function () { form.classList.add('is-open'); form.scrollIntoView({ behavior: 'smooth', block: 'center' }); var n = form.querySelector('input[type="text"]'); if (n) setTimeout(function () { n.focus({ preventScroll: true }); }, 400); });
  });
  var more = root.querySelector('[data-more]');
  if (more) more.addEventListener('click', function () { root.querySelectorAll('[data-extra]').forEach(function (c) { c.hidden = false; }); more.parentNode.remove(); });
  if (location.hash.indexOf('{{ form_id }}') > -1 || location.search.indexOf('contact_posted') > -1) form.classList.add('is-open');
})();
</script>

{% schema %}
{
  "name": "Yorum Duvarı",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Müşteri Yorumları" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Patiler ne diyor?" },
    { "type": "range", "id": "initial", "label": "İlk gösterilen yorum sayısı", "min": 3, "max": 24, "step": 3, "default": 6 },
    { "type": "text", "id": "empty_title", "label": "Yorum yokken başlık", "default": "İlk yorumu siz yazın" },
    { "type": "textarea", "id": "empty_text", "label": "Yorum yokken metin", "default": "Askılı botu kullandıysanız deneyiminizi paylaşın; sizin yorumunuz başka köpek sahiplerinin doğru seçimi yapmasına yardımcı olur." },
    { "type": "paragraph", "content": "Yorumlar: her gerçek müşteri yorumu için bir \"Yorum\" bloğu ekleyin. Ortalama puan ve dağılım otomatik hesaplanır. Formdan gelen yorumlar mağaza e-postanıza düşer." },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Yorum",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Müşteri fotoğrafı" },
        { "type": "range", "id": "rating", "label": "Puan", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Başlık" },
        { "type": "richtext", "id": "text", "label": "Yorum" },
        { "type": "text", "id": "name", "label": "İsim (ör. Ayşe K.)" },
        { "type": "text", "id": "city", "label": "Şehir" },
        { "type": "text", "id": "date", "label": "Tarih (ör. Ekim 2026)" },
        { "type": "checkbox", "id": "verified", "label": "Doğrulanmış alıcı (yalnızca siparişi olan müşteriler için)", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Yorum Duvarı" }]
}
{% endschema %}
