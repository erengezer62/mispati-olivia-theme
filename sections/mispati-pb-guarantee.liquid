<section class="pb pb--green" style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pb__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="pb__head" style="margin-bottom:36px"><h2 class="pb__title" style="font-size:clamp(26px,3vw,38px)">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="pb-guar">
      {%- for block in section.blocks -%}
        <div class="pb-guar__item" {{ block.shopify_attributes }}>
          <span class="pb-icon">{% render 'mispati-icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Güvence",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Başlık" },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "item", "name": "Güvence", "settings": [
      { "type": "select", "id": "icon", "label": "İkon", "options": [{ "value": "strap", "label": "Askı" }, { "value": "drop", "label": "Su" }, { "value": "sole", "label": "Taban" }, { "value": "reflect", "label": "Reflektör" }, { "value": "leg", "label": "Bacak" }, { "value": "adjust", "label": "Ayar" }, { "value": "snow", "label": "Kar" }, { "value": "rain", "label": "Yağmur" }, { "value": "moon", "label": "Gece" }, { "value": "mountain", "label": "Doğa" }, { "value": "paw", "label": "Pati" }, { "value": "shield", "label": "Kalkan" }, { "value": "return", "label": "İade" }, { "value": "cash", "label": "Kapıda ödeme" }, { "value": "card", "label": "Kart" }, { "value": "truck", "label": "Kargo" }, { "value": "gift", "label": "Hediye" }, { "value": "check", "label": "Onay" }], "default": "shield" },
      { "type": "text", "id": "title", "label": "Başlık", "default": "Başlık" },
      { "type": "textarea", "id": "text", "label": "Metin" }
    ] }
  ],
  "presets": [{ "name": "Premium Güvence", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
