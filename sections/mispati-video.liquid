<section class="mp-section mp-video{% if section.settings.full_width %} mp-video--full{% endif %}{% if section.settings.cream %} mp-section--cream{% endif %}" style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="mp-container">
    {%- if section.settings.heading != blank -%}<h2 class="mp-heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="mp-subheading">{{ section.settings.text }}</div>{%- endif -%}
    <div class="mp-video__frame">
      {%- if section.settings.video != blank -%}
        {%- if section.settings.controls -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: true, preload: 'metadata', image_size: '1600x' }}
        {%- else -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1600x' }}
        {%- endif -%}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mispati Video",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "image", "label": "Video yoksa görsel" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık" },
    { "type": "richtext", "id": "text", "label": "Açıklama" },
    { "type": "checkbox", "id": "full_width", "label": "Tam genişlik", "default": false },
    { "type": "checkbox", "id": "controls", "label": "Oynatıcı kontrollerini göster", "default": false },
    { "type": "checkbox", "id": "cream", "label": "Krem arka plan", "default": false },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Mispati Video" }]
}
{% endschema %}
