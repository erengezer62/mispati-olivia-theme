{%- style -%}
  .mp-ticker-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.fg }}; overflow: hidden; }
  .mp-ticker-{{ section.id }} .mp-ticker__track { display: flex; width: max-content; animation: mpTicker {{ section.settings.speed }}s linear infinite; }
  .mp-ticker-{{ section.id }}:hover .mp-ticker__track { animation-play-state: paused; }
  .mp-ticker-{{ section.id }} .mp-ticker__item { display: inline-flex; align-items: center; gap: 10px; padding: 10px 28px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; white-space: nowrap; }
  .mp-ticker-{{ section.id }} .mp-ticker__dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: 0.6; }
  @keyframes mpTicker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .mp-ticker-{{ section.id }} .mp-ticker__track { animation: none; } }
{%- endstyle -%}
{%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
<div class="mp-ticker mp-ticker-{{ section.id }}" role="region" aria-label="Duyurular">
  <div class="mp-ticker__track">
    {%- for n in (1..2) -%}
      {%- for rep in (1..3) -%}
        {%- for it in items -%}
          {%- assign t = it | strip -%}
          {%- if t != blank -%}
            <span class="mp-ticker__item"{% if n == 2 %} aria-hidden="true"{% endif %}><span class="mp-ticker__dot"></span>{{ t }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Mispati Kayan Duyuru",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "items", "label": "Duyurular (her satıra bir tane)", "default": "Peşin Fiyatına Taksit\nÜcretsiz Kargo\nKapıda Ödeme\n30 Gün Değişim/İade" },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#bda66c" },
    { "type": "color", "id": "fg", "label": "Yazı rengi", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Hız (saniye, düşük = hızlı)", "min": 10, "max": 80, "step": 2, "default": 36 }
  ],
  "presets": [{ "name": "Mispati Kayan Duyuru" }]
}
{% endschema %}
