<section
  class="mp27 mp27-trust mp27--{{ section.settings.bg }} mp27-pad"
  style="--mp27-pt: {{ section.settings.pt }}px; --mp27-pb: {{ section.settings.pb }}px;"
>
  <div class="mp26-wrap">
    <div class="mp27-trust__grid">
      <div class="mp27-trust__pitch">
        <div>
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <div>
            <a class="mp26-btn mp26-btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label -}}
              {% render 'mispati-icon', name: 'arrow-right' %}
            </a>
          </div>
        {%- endif -%}
      </div>
      <div class="mp27-trust__items">
        {%- for block in section.blocks -%}
          <div class="mp27-trust__item" {{ block.shopify_attributes }}>
            {% render 'mispati-icon', name: block.settings.icon %}
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mispati 2027 Güven",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Arka plan", "default": "paper", "options": [
      { "value": "paper", "label": "Kağıt" },
      { "value": "sand", "label": "Kum" },
      { "value": "white", "label": "Beyaz" }
    ] },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bedenden emin değil misin?" },
    { "type": "textarea", "id": "text", "label": "Metin" },
    { "type": "text", "id": "button_label", "label": "Buton" },
    { "type": "url", "id": "button_link", "label": "Buton bağlantısı" },
    { "type": "range", "id": "pt", "label": "Üst boşluk", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "pb", "label": "Alt boşluk", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Madde",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Simge", "default": "truck", "options": [
          { "value": "truck", "label": "Kargo" },
          { "value": "cash", "label": "Nakit" },
          { "value": "card", "label": "Kart" },
          { "value": "return", "label": "İade" },
          { "value": "shield", "label": "Kalkan" },
          { "value": "gift", "label": "Hediye" },
          { "value": "paw", "label": "Pati" }
        ] },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Ücretsiz kargo" },
        { "type": "textarea", "id": "text", "label": "Metin" }
      ]
    }
  ],
  "presets": [{ "name": "Mispati 2027 Güven" }]
}
{% endschema %}
